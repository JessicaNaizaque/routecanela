# Upload this file as ".htaccess" inside your /demo folder on the server
# (i.e. it will live at https://www.routecanela.de/demo/.htaccess).
#
# It makes client-side routing work on deep links/refresh and caches the
# content-hashed build output aggressively while keeping index.html fresh.

# --- SPA client-side routing fallback ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (root rules no longer reach /demo once we define our own)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-SSL} !on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Force www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # SPA fallback for the /demo app
  RewriteBase /demo/
  # Serve existing files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # A missing static asset (js/css/etc.) must 404 instead of returning the
  # HTML shell -- otherwise the browser gets text/html for a module script and
  # fails with a MIME-type error, showing a blank page.
  RewriteRule \.(js|mjs|css|map|json|png|jpe?g|gif|svg|webp|ico|woff2?|mp4|webm)$ - [R=404,L]
  # Everything else (real client-side routes) falls back to the app entry point
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite emits content-hashed filenames -> safe to cache forever
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate the HTML entry so new deploys show up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Compress text assets ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>